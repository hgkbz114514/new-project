# ─────────────────────────────────────────────────────────────
# 运行产物 —— 全部可以重新生成，不进版本库
# ─────────────────────────────────────────────────────────────

# 节点数据与配置：profiles/ 里 47 MB 几乎全是 geo 二进制 + 抓来的节点池。
# geoip.dat / GeoSite.dat / *.mmdb 会在首次运行时从 Clash Verge 复制过来，
# nodes_*.json 是流水线中间产物，vpnkit.yaml 每次 build 都重新生成。
profiles/

# 日志（含内核 stdout/stderr、各脚本结构化日志、stdout 兜底日志）
09_logs/

# 备份目录：里面有 Chrome Local State、hosts、各类凭证快照，绝不能进公开仓库
10_backup/

# 桌面快捷方式生成物、图标预览、临时探针输出
*.png
!vpnkit.ico
!claude.ico
_icon_preview*.png
*.lnk

# ─────────────────────────────────────────────────────────────
# 与本项目无关的临时目录（开发机上有，别人 clone 不会有）
# ─────────────────────────────────────────────────────────────
11_dshpurge/
_tools/
bin/misc/
bin/_archive/
bin/_tmp/

# 诊断脚本临时落地的东西
_tmp/
*.tmp

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────────────────────
# 敏感 / 本地环境
# ─────────────────────────────────────────────────────────────
# 明确禁止任何形式把凭证带进来
*.key
*.pem
*.crt
*.p12
*.pfx
credentials*
.env
.env.*
!.env.example

# 抓包 / 测速的临时样本
*.pcap
*.har
speed_sample*

# ─────────────────────────────────────────────────────────────
# 编辑器 / 系统
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
